# ==============================================================================
# SevaConnect Deployment & Environment Configuration Template
# NOTE: Do NOT commit production secrets to version control.
# In Vercel, configure these under: Project Settings -> Environment Variables.
# ==============================================================================

# MongoDB Connection String (MongoDB Atlas cluster URI)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/sevaconnect?retryWrites=true&w=majority

# JWT Authentication Secret Key (Used for signing & verifying session tokens)
JWT_SECRET=your-strong-production-jwt-secret-key-here

# Local Development Port (Express Backend)
PORT=5000

# AI Microservice URL (Local: http://localhost:8000 | Production: deployed AI URL or relative /ai)
AI_SERVICE_URL=http://localhost:8000

# Node Environment ('production' or 'development')
NODE_ENV=production
