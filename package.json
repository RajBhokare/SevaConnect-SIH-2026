{
  "name": "sevaconnect-workspace",
  "version": "1.0.0",
  "description": "SevaConnect - Cooperative-Owned Independent Worker Marketplace",
  "scripts": {
    "dev": "concurrently -n \"WEB,API,AI\" -c \"cyan.bold,green.bold,magenta.bold\" \"npm --silent --prefix frontend run dev\" \"npm --silent --prefix backend start\" \"python ai/main.py\"",
    "dev:all": "npm run dev",
    "dev:frontend": "npm --silent --prefix frontend run dev",
    "dev:backend": "npm --silent --prefix backend start",
    "dev:ai": "python ai/main.py",
    "build": "npm --prefix frontend run build",
    "build:frontend": "npm --prefix frontend run build",
    "start": "npm --prefix backend start"
  },
  "keywords": [
    "sevaconnect",
    "sih2026",
    "cooperative",
    "marketplace"
  ],
  "author": "SevaConnect Team",
  "license": "ISC",
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
